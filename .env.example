# Igris AI Brain Configuration
# Copy to .env and fill in your values

# Remote brain server
# Use https:// — sync over plain http:// to a non-local host is REFUSED
# because the api_key would travel in cleartext. To override on a trusted LAN,
# set IGRIS_ALLOW_INSECURE_SYNC=1 (one-shot, never `export`).
IGRIS_REMOTE_BRAIN_URL=https://your-vps-domain:3001
IGRIS_BRAIN_API_KEY=your-api-key-here

# Transport-security override (default: refuse non-local http://).
# Uncomment ONLY on a trusted LAN where the VPS has no TLS. One-shot — never
# `export` it (it would inherit into subagent spawns). Also settable as a
# persistent config.json key: remote_brain.allow_insecure: true
# IGRIS_ALLOW_INSECURE_SYNC=1

# VPS deployment
IGRIS_VPS_HOST=your-vps-ip
IGRIS_VPS_USER=root

# IGRIS_REPO_DIR — TEST SEAM (TD-406). Declares the only subtree a CANONICAL repo
# write may land in (tracked files inside a checkout, e.g. core/SOUL.md). Its twin
# IGRIS_BRAIN_DIR covers the runtime tree under ~/.igris; this one covers the
# checkout. Fails CLOSED: under VITEST or NODE_ENV=test, a canonical target
# outside the declared root is REFUSED rather than written. Leave unset in
# production — unset plus no test context allows every target, as before.
# IGRIS_REPO_DIR=/abs/path/to/checkout
