# Igris AI Brain Configuration
# Copy to .env and fill in your values

# Remote brain server
# Use https:// — sync over plain http:// to a non-local host is REFUSED
# because the api_key would travel in cleartext. To override on a trusted LAN,
# set IGRIS_ALLOW_INSECURE_SYNC=1 (one-shot, never `export`).
IGRIS_REMOTE_BRAIN_URL=https://your-vps-domain:3001
IGRIS_BRAIN_API_KEY=your-api-key-here

# Transport-security override (default: refuse non-local http://).
# Uncomment ONLY on a trusted LAN where the VPS has no TLS. One-shot — never
# `export` it (it would inherit into subagent spawns). Also settable as a
# persistent config.json key: remote_brain.allow_insecure: true
# IGRIS_ALLOW_INSECURE_SYNC=1

# VPS deployment
IGRIS_VPS_HOST=your-vps-ip
IGRIS_VPS_USER=root

# IGRIS_REPO_DIR — TEST SEAM (TD-406, extended by TD-408). Declares the only
# subtree a CANONICAL repo write may land in (tracked files inside a checkout).
# Its twin IGRIS_BRAIN_DIR covers the runtime tree under ~/.igris; this one covers
# the checkout. Fails CLOSED: under VITEST or NODE_ENV=test, a target outside the
# declared root is REFUSED rather than written. Leave unset in production — unset
# plus no test context allows every target, as before.
# Honoured by: applyPersona's core/SOUL.md write; projectSettingsPath, so both
# hook projection verbs' .claude/settings.json write; and the harness verb, which
# refuses to SPAWN compile_harnesses.sh / check_harness_drift.sh with an
# uncontained --project-root (those write in bash, where this var does not reach).
# Not honoured by the bats suites — they set neither VITEST nor NODE_ENV, so they
# take the production path; scripts/worktree_write_gate.sh is what covers them.
# IGRIS_REPO_DIR=/abs/path/to/checkout

# IGRIS_BRAIN_DIR / IGRIS_DB_PATH — SANDBOX SEAMS (TD-426). A test, build or
# script that boots the brain outside ~/.igris sets IGRIS_BRAIN_DIR: it moves the
# CLI helpers' brain root, the server DB (<dir>/memory/knowledge.db — create
# memory/ first) and the pidfile registry together. IGRIS_DB_PATH is a full-path
# override honoured ONLY by the standalone server boot and brain-mcp-server/
# scripts/; CLI verbs and the dashboard ignore it by design (FR-241 poison fence).
# Precedence and the build guard: docs/SETUP_GUIDE.md "Sandboxing the brain".
# Leave both unset in production.
# IGRIS_BRAIN_DIR=/abs/path/to/sandbox
# IGRIS_DB_PATH=/abs/path/to/sandbox/memory/knowledge.db
