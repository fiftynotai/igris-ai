{
  "$schema": "core/scripts/cli-adapters/manifest.schema.json",
  "_comment": "Igris-ai PROJECT harness manifest (FR-136). Declares the 9 core agents whose codex harnesses are mechanically regenerated from their canonical core/agents/<name>.md prompts (TD-021). Core ships only the SCHEMA (core/scripts/cli-adapters/manifest.schema.json); each project ships its own data manifest at its repo root. Canonical is the SOLE source of truth; every target listed here is a GENERATED artifact - editing a target file directly is a process error. Personal/Layer-2 customizations are NOT declared here - they live in an optional gitignored overlay at ~/.igris/loadout/harness-manifest.personal.json (FR-139). FR-202 M4: the os_identity surface (TD-233) was retired — the orchestrator no longer projects an identity region into any harness's auto-read file. The per-harness delegation mechanism is now a CONTEXT LAYER (core/os/harness-specific/<harness>.md, loaded at Boot for the Detect-resolved harness), not a projected surface.",
  "version": 1,
  "_harnesses_comment": "Per-harness `delegation_model` — the applicability predicate for the harness-specific context layer (FR-202 M4). `native-static` = the harness loads Igris agents statically and a skill delegating via `subagent_type:<agent>` resolves directly (no harness-specific file needed). `dynamic-define` = the harness cannot load static Igris agents but defines subagents at runtime (e.g. Antigravity `define_subagent`/`invoke_subagent`); it has a `core/os/harness-specific/<harness>.md` file pointing at the shared delegation recipe, so the orchestrator is taught 'read ~/.igris/core/agents/<X>.md → define_subagent → invoke' ONCE at Boot, with ZERO per-skill branching. A harness absent from this map defaults to native-static. This is no longer a projected surface (the recipe was re-homed off the identity region into the harness-specific layer); the map survives only to select which harness-specific file applies. FR-217: each harness block is EXTENDED into the canonical harness descriptor — `agent_id` (the npx agent id; differs only claude→claude-code, gemini→gemini-cli), `agents`{target_type,projection} (absent for antigravity = dynamic-define, no static agent surface), `mcp`{config_path,format,map_key,entry_shape} (antigravity rides the gemini entry_shape but a DISTINCT config_path, FR-179 R1), `grant`{kind,path?,token?}, `hooks`{supported,config_path?,method?}, and `harness_specific_file?`. This is the SINGLE source of truth every harness-wiring consumer reads (TS via cli/src/lib/harness-descriptor.ts). Per-surface participation is DERIVED from block presence (agents/mcp/hooks.supported/grant), not a separate list. Additive — still v1.",
  "harnesses": {
    "claude": {
      "delegation_model": "native-static",
      "agent_id": "claude-code",
      "agents": { "target_type": "claude", "projection": "symlink" },
      "mcp": { "config_path": "~/.claude.json", "format": "json", "map_key": "mcpServers", "entry_shape": "claude" },
      "grant": { "kind": "json-array", "path": "~/.claude/settings.json", "token": "mcp__igris-brain__*" },
      "hooks": { "supported": true, "config_path": "~/.claude/settings.json", "method": "settings-merge" }
    },
    "codex": {
      "delegation_model": "native-static",
      "agent_id": "codex",
      "agents": { "target_type": "codex", "projection": "target-row" },
      "mcp": { "config_path": "~/.codex/config.toml", "format": "toml", "map_key": "mcp_servers", "entry_shape": "codex" },
      "grant": { "kind": "toml-folder", "path": "~/.codex/config.toml" },
      "hooks": { "supported": false }
    },
    "gemini": {
      "delegation_model": "dynamic-define",
      "agent_id": "gemini-cli",
      "agents": { "target_type": "gemini", "projection": "target-row" },
      "mcp": { "config_path": "~/.gemini/settings.json", "format": "json", "map_key": "mcpServers", "entry_shape": "gemini" },
      "grant": { "kind": "json-folder", "path": "~/.gemini/trustedFolders.json" },
      "hooks": { "supported": false },
      "harness_specific_file": "core/os/harness-specific/gemini.md"
    },
    "opencode": {
      "delegation_model": "native-static",
      "agent_id": "opencode",
      "agents": { "target_type": "opencode", "projection": "target-row" },
      "mcp": { "config_path": "~/.config/opencode/opencode.json", "format": "json", "map_key": "mcp", "entry_shape": "opencode" },
      "grant": { "kind": "covered" },
      "hooks": { "supported": true, "method": "plugin" }
    },
    "antigravity": {
      "delegation_model": "dynamic-define",
      "agent_id": "antigravity",
      "mcp": { "config_path": "~/.gemini/config/mcp_config.json", "format": "json", "map_key": "mcpServers", "entry_shape": "gemini" },
      "grant": { "kind": "json-array", "path": "~/.gemini/antigravity-cli/settings.json", "token": "mcp(igris-brain/*)" },
      "hooks": { "supported": true, "config_path": "~/.gemini/config/hooks.json", "method": "config-merge" },
      "harness_specific_file": "core/os/harness-specific/antigravity.md"
    }
  },
