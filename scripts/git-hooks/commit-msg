#!/bin/bash

# Description: Igris commit-msg hook. Three checks, in this order:
#
#   1. SUMMARY LENGTH (TD-180) — hard-fails a commit whose summary (the first
#      non-comment, non-blank line) exceeds 72 characters. The locked
#      convention is ≤72: a 72-char summary passes, 73 fails. See
#      core/os/standards.md ("72-char summary") and
#      core/templates/commit_message.md ("Max 72 characters").
#
#   2. ACCEPTANCE-CRITERIA GATE (TD-325) — hard-fails a CLOSING commit (one
#      carrying a `closes #<BRIEF_ID>` footer) when that brief still has an
#      unticked acceptance criterion, or a deferral without a reason and a
#      follow-up brief. Bypass: IGRIS_BYPASS_AC_GATE=1.
#
#   3. AGENT-EVENT COVERAGE GATE (FR-267) — hard-fails a CLOSING commit when a
#      role named in that brief's Agent Log has NO recorded agent event (no
#      `agent_events` row with event_type start/stop/error for the brief).
#      The Agent Log is the brief's own statement of who worked on it; the
#      hunt-cost record (`agent_events`, brain-timed) is what makes that
#      statement measurable, and emission was 31% compliant while it was
#      prose (L-1402). A role with a start but no stop/error is a WARN, not a
#      refusal — a crashed agent still ran. Bypass: IGRIS_BYPASS_EVENT_GATE=1.
#
#   The three are independent: the length check runs first and is unchanged
#   (test/commit_msg_length.test.bash is its regression control). §2 and §3
#   share one PRELUDE — the closing-footer parse and the brain-DB access — but
#   each has its OWN bypass and its OWN parser resolution, so a bypass of one
#   gate never silences the other (test/agent_event_gate.test.bash G6 pins
#   both directions; before FR-267 the AC bypass was a bare `exit 0`, which
#   would have disabled §3 by construction). Both verdict blocks print before
#   the single exit, and the bypass hint names only the gate(s) that refused.
#
# Usage: git invokes this as `.git/hooks/commit-msg <msg-file>`.
#   Argument $1 is the path to the file holding the pending commit message.
#
# No `set -e`: `grep` returns non-zero when a pattern does not match (e.g. a
#   comment-only message), which would abort the hook under `set -e`. Every
#   step is guarded explicitly and the empty-message case falls through to
#   exit 0 (let git handle an empty commit itself; don't block).
#
# WHY THE AC GATE LIVES HERE AND NOT IN THREE OTHER PLACES (TD-325 §0):
#
#   NOT in `igris_brief_sync` (the brain). Both of /hunt's terminal syncs run
#   AFTER the commit has landed — Phase 7 orders 7.1 phase=COMMITTING, 7.2
#   `git commit`, 7.4 status=Done, 7.5 sync; Phase 8.2 syncs phase=COMPLETE. A
#   rejecting brain gate cannot un-close anything; it can only refuse to RECORD
#   something already true in the world. Keyed on `status` it leaves a landed
#   commit with the store saying open — contradiction C3 in
#   scripts/validate_brief_state_reconciliation.sh. Keyed on phase='COMPLETE'
#   it manufactures C1, which TD-311 then forbids fixing by editing brief data,
#   trapping the operator in a state the system will not let them leave. Either
#   key makes the store LESS truthful. The brain gets the OBSERVER role instead
#   (the `nonCanonical*Note` pattern: informs, never rejects).
#
#   NOT in the pre-commit phase guard. `scripts/git-hooks/pre-commit` wraps
#   that whole guard in `IGRIS_BYPASS_PHASE_GUARD != 1`, and /hunt's COMMITTING
#   step SETS that flag on the exact commit we need to gate. A check inside
#   that block is bypassed by construction on every closing commit.
#
#   HERE, because the closing commit is DEFINED by its `closes #<ID>` footer —
#   already this repo's own definition of closed
#   (validate_brief_state_reconciliation.sh:95) — and commit-msg is the only
#   hook that sees the message. So the gate needs no phase heuristic at all: a
#   WIP commit has no footer and is untouched. The "don't block mid-build
#   commits" problem disappears rather than being mitigated, the gate and the
#   C2/C3 reconciliation check agree by construction, and there is no
#   entanglement with IGRIS_BYPASS_PHASE_GUARD and no dependence on the
#   `instances` registry (no stale-instance failure mode, the G-01R class).
#
#   The event gate (§3) inherits every one of those reasons: it is a check on
#   the same footer, against the same stored brief, and it too would be
#   bypassed by construction inside the phase guard.
#
# WHAT THESE GATES DO NOT COVER — named, because an unnamed gap is worse than a
#   known one:
#     - a close with NO commit: /archive, a direct igris_brief_sync, the
#       dashboard, or remote sync. Refusing those is the C1/C3 manufacture
#       argued above, so they are OBSERVED instead — by the acGateNote in
#       brain-mcp-server/src/tools/briefs.ts at the moment of the sync, and by
#       scripts/validate_brief_ac_completion.sh on the next brief-state commit.
#       (§3 has no observer yet; the OS-wide roll-up is `igris kpi` —
#       docs/reference/os-kpis.md, FR-268.)
#     - `git commit --no-verify` (git skips every hook natively).
#     - a checkout without the hooks installed, or a project whose briefs live
#       in a different brain.
#     - §3 only: a brain older than the FR-267 schema (no `agent_events`
#       table → skip), an Agent Log written as a bullet list (the v4 template
#       parses to no roles → nothing demanded), and roles the log does NOT
#       name (the gate reads the log you wrote; a skipped phase demands
#       nothing).
#   All of those land in the same L3 accumulation net.
#
# Bypass: `git commit --no-verify` (git skips this hook entirely — native, no
#   code here). Use sparingly.
# Bypass the AC gate only:    `IGRIS_BYPASS_AC_GATE=1 git commit ...`
# Bypass the event gate only: `IGRIS_BYPASS_EVENT_GATE=1 git commit ...`
#   One-shot, never `export`ed — same posture as IGRIS_BYPASS_PHASE_GUARD and
#   IGRIS_BYPASS_BRIEF_GATE.

MSG_FILE="$1"

# No message file (or it does not exist) -> nothing to measure; let git proceed.
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# Summary = the first line that is neither a `#` comment nor blank. Git's
# default template puts comment lines (starting with `#`) below the summary;
# a leading comment block (or verbose-mode diff) must be skipped so we measure
# the real subject line.
summary="$(grep -vE '^[[:space:]]*#' "$MSG_FILE" | grep -vE '^[[:space:]]*$' | head -n1)"

# Empty / comment-only message -> pass through (git will reject an empty commit
# on its own; the length guard has nothing to enforce).
[ -n "$summary" ] || exit 0

# ${#var} counts CHARACTERS (not bytes) in a UTF-8 locale — the intended unit.
# Commit summaries are near-universally ASCII, so this is exact in practice.
len=${#summary}

if [ "$len" -gt 72 ]; then
  echo ""
  echo "[commit-msg] summary too long: ${len} chars (max 72)"
  echo "  summary: ${summary}"
  echo "  shorten the first line to ≤72 chars (imperative mood). See core/os/standards.md."
  echo "  bypass (discouraged): git commit --no-verify"
  echo ""
  exit 1
fi

# =============================================================================
# Shared prelude for the two closing-commit gates (§2 and §3)
# =============================================================================
# FAIL-OPEN AT EVERY TIER. This hook runs on every commit in every repo that
# installs it; a missing brain DB, a missing sqlite3, a brief with no stored
# content, or a missing parser must never block a commit. The ONLY exit-1
# paths below are a parser returning FAIL (§2) or a named role with no event
# (§3) on a brief this commit claims to close.

# --- Is this a CLOSING commit? -----------------------------------------------
# Comment lines are stripped first, so a `closes #` appearing in git's own
# commentary (or in a verbose-mode diff hunk) cannot fake a closing footer.
#
# The footer pattern FOLDS NOTATION, not vocabulary. Measured over the last 400
# commits of this repo: 343 `closes #<ID>`, 1 `closes <ID>` (no hash), 1
# `close <ID>`. So: clos(e|es|ed), an optional colon, an optional `#`. The id
# itself is then re-extracted CASE-SENSITIVELY, so only a canonical uppercase
# brief id is ever interpolated into SQL.
#
# ALL ids are gated, not just the first: a commit closing two briefs must
# satisfy both.
msg_body="$(grep -vE '^[[:space:]]*#' "$MSG_FILE" 2>/dev/null)"
brief_ids="$(printf '%s\n' "$msg_body" \
  | grep -ioE 'clos(e|es|ed)[[:space:]]*:?[[:space:]]*#?[A-Z]{2,3}-[0-9]+' 2>/dev/null \
  | grep -oE '[A-Z]{2,3}-[0-9]+' 2>/dev/null \
  | sort -u)"

# No footer -> not a closing commit -> both gates are silent. This is why
# mid-hunt WIP commits need no phase heuristic to be exempt.
[ -n "$brief_ids" ] || exit 0

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$REPO_ROOT" ] || exit 0

BRAIN_DB="$HOME/.igris/memory/knowledge.db"
[ -f "$BRAIN_DB" ] || exit 0
command -v sqlite3 >/dev/null 2>&1 || exit 0

# $PROJECT is basename(repo) and each id matched ^[A-Z]{2,3}-[0-9]+$ above —
# neither is user-controlled free text. Both are still single-quote-escaped
# (doubling any embedded quote) before interpolation, matching the
# pre-commit idiom. The DB is opened -readonly: this hook never writes.
PROJECT="$(basename "$REPO_ROOT")"
PROJECT_SQL="${PROJECT//\'/\'\'}"

# =============================================================================
# 2. Acceptance-criteria gate (TD-325)
# =============================================================================
# The bypass is a SECTION skip, not an exit: §3 still runs (FR-267).
ac_failed=0
if [ "${IGRIS_BYPASS_AC_GATE:-0}" != "1" ]; then
  # --- Resolve the shared parser (repo first, runtime mirror second) ----------
  # core/scripts/brief_ac_check.sh is the ONE checkbox parser; /hunt and the L3
  # validator read the same file. Preferring the repo copy means a change to
  # the parser is gated by the parser as edited, not by a stale mirror.
  AC_CHECK=""
  if [ -f "$REPO_ROOT/core/scripts/brief_ac_check.sh" ]; then
    AC_CHECK="$REPO_ROOT/core/scripts/brief_ac_check.sh"
  elif [ -f "$HOME/.igris/core/scripts/brief_ac_check.sh" ]; then
    AC_CHECK="$HOME/.igris/core/scripts/brief_ac_check.sh"
  fi

  if [ -n "$AC_CHECK" ]; then
    for BRIEF_ID in $brief_ids; do
      BRIEF_SQL="${BRIEF_ID//\'/\'\'}"
      brief_content="$(sqlite3 -readonly "$BRAIN_DB" \
        "SELECT content FROM brief_files WHERE project='$PROJECT_SQL' AND brief_id='$BRIEF_SQL' LIMIT 1;" \
        2>/dev/null)"

      # No stored content for this project+brief -> nothing to read -> stay
      # silent. (A brief tracked in another project's brain, or one that
      # predates brief_files, must not block this repo's commits.)
      [ -n "$brief_content" ] || continue

      if ac_out="$(printf '%s\n' "$brief_content" \
                     | bash "$AC_CHECK" --brief-id "$BRIEF_ID" --guidance - 2>/dev/null)"; then
        # PASS / NO_AC / NO_ITEMS / DEGRADED — all exit 0 by contract.
        continue
      fi

      if [ "$ac_failed" -eq 0 ]; then
        echo ""
        echo "[commit-msg] TD-325 AC gate: refusing to close a brief with unmet criteria"
        echo ""
      fi
      printf '%s\n' "$ac_out"
      ac_failed=1
    done
  fi
fi

# =============================================================================
# 3. Agent-event coverage gate (FR-267)
# =============================================================================
# [[ FR-267 EVENT GATE BEGIN ]]  (the bats self-negative control G10 deletes
#                                 this block by its markers — keep them intact)
#
# For every brief this commit closes: read its stored content, ask the ONE
# Agent-Log parser (core/scripts/brief_agent_log_roles.sh) which roles the log
# names, and require at least one start/stop/error row per role in
# `agent_events` for that brief. The `project` predicate is applied only when
# the column exists (FR-267 schema v3); rows with a NULL project — written
# before the column — still count, because they were the record at the time.
#
# Fail-open tiers, in order: no parser anywhere → skip; no `agent_events`
# table (a brain older than FR-267) → skip; no stored content → skip that
# brief; a log that parses to no roles (NO_LOG / NO_ROWS) → nothing demanded;
# a read that errors → WARN and skip that role.
event_failed=0
if [ "${IGRIS_BYPASS_EVENT_GATE:-0}" != "1" ]; then
  ROLES_CHECK=""
  if [ -f "$REPO_ROOT/core/scripts/brief_agent_log_roles.sh" ]; then
    ROLES_CHECK="$REPO_ROOT/core/scripts/brief_agent_log_roles.sh"
  elif [ -f "$HOME/.igris/core/scripts/brief_agent_log_roles.sh" ]; then
    ROLES_CHECK="$HOME/.igris/core/scripts/brief_agent_log_roles.sh"
  fi

  if [ -n "$ROLES_CHECK" ]; then
    has_table="$(sqlite3 -readonly "$BRAIN_DB" \
      "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='agent_events';" 2>/dev/null)"
    if [ "$has_table" = "1" ]; then
      has_project="$(sqlite3 -readonly "$BRAIN_DB" \
        "SELECT COUNT(*) FROM pragma_table_info('agent_events') WHERE name='project';" 2>/dev/null)"
      project_pred=""
      if [ "$has_project" = "1" ]; then
        project_pred=" AND (project='$PROJECT_SQL' OR project IS NULL)"
      fi

      for BRIEF_ID in $brief_ids; do
        BRIEF_SQL="${BRIEF_ID//\'/\'\'}"
        brief_content="$(sqlite3 -readonly "$BRAIN_DB" \
          "SELECT content FROM brief_files WHERE project='$PROJECT_SQL' AND brief_id='$BRIEF_SQL' LIMIT 1;" \
          2>/dev/null)"
        [ -n "$brief_content" ] || continue

        roles="$(printf '%s\n' "$brief_content" \
                   | bash "$ROLES_CHECK" --brief-id "$BRIEF_ID" --roles - 2>/dev/null)"
        [ -n "$roles" ] || continue

        all_roles=""
        missing=""
        unpaired=""
        while IFS= read -r role; do
          [ -n "$role" ] || continue
          ROLE_SQL="${role//\'/\'\'}"
          all_roles="${all_roles:+$all_roles,}$role"

          n_any="$(sqlite3 -readonly "$BRAIN_DB" \
            "SELECT COUNT(*) FROM agent_events WHERE brief_id='$BRIEF_SQL' AND agent='$ROLE_SQL' AND event_type IN ('start','stop','error')$project_pred;" \
            2>/dev/null)"
          case "$n_any" in
            ''|*[!0-9]*)
              echo "EVENT-GATE $BRIEF_ID: WARN could not read agent_events for role '$role' (skipped, fail-open)"
              continue
              ;;
          esac
          if [ "$n_any" -eq 0 ]; then
            missing="${missing:+$missing,}$role"
            continue
          fi

          n_end="$(sqlite3 -readonly "$BRAIN_DB" \
            "SELECT COUNT(*) FROM agent_events WHERE brief_id='$BRIEF_SQL' AND agent='$ROLE_SQL' AND event_type IN ('stop','error')$project_pred;" \
            2>/dev/null)"
          if [ "${n_end:-0}" = "0" ]; then
            unpaired="${unpaired:+$unpaired,}$role"
          fi
        done <<< "$roles"

        if [ -n "$missing" ]; then
          if [ "$event_failed" -eq 0 ]; then
            echo ""
            echo "[commit-msg] FR-267 event gate: refusing to close a brief whose Agent Log names a role with no recorded agent event"
            echo ""
          fi
          echo "EVENT-GATE $BRIEF_ID: VERDICT=FAIL roles=$all_roles missing=$missing"
          echo "  every role the Agent Log names must have at least one igris_agent_event"
          echo "  row (start, stop or error) for this brief — that row IS the hunt-cost"
          echo "  record. Emit the missing event, or correct the log if it names"
          echo "  something that is not an agent."
          event_failed=1
        fi

        if [ -n "$unpaired" ]; then
          # A start with no stop/error: the agent ran but never reported back.
          # Not a refusal — a crashed agent is still a real invocation — but
          # the duration for that round is NULL, so say so.
          _rest="$unpaired"
          while [ -n "$_rest" ]; do
            _one="${_rest%%,*}"
            if [ "$_one" = "$_rest" ]; then _rest=""; else _rest="${_rest#*,}"; fi
            echo "EVENT-GATE $BRIEF_ID: WARN unpaired: $_one (start recorded, no stop/error — duration NULL)"
          done
        fi
      done
    fi
  fi
fi
# [[ FR-267 EVENT GATE END ]]

# =============================================================================
# Single exit: both verdict blocks are already printed; the hint names only
# the gate(s) that refused.
# =============================================================================
if [ "$ac_failed" -eq 1 ] || [ "$event_failed" -eq 1 ]; then
  echo ""
  echo "  One-shot bypass (leaves a trail in this terminal, never export it):"
  if [ "$ac_failed" -eq 1 ]; then
    echo "    IGRIS_BYPASS_AC_GATE=1 git commit ..."
  fi
  if [ "$event_failed" -eq 1 ]; then
    echo "    IGRIS_BYPASS_EVENT_GATE=1 git commit ..."
  fi
  echo ""
  exit 1
fi

exit 0
