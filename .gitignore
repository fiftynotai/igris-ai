# OS Files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
.temp/
temp/

# Logs
*.log
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/

# Node
node_modules/

# Build artifacts
dist/
build/
*.zip
*.tar.gz

# Test fixtures — explicitly committed tarball fixtures (zip-slip + clean-core)
# for cli/src/__tests__/tarball.test.ts and cli/tests/integration/tarball-zip-slip.bats
!cli/src/__tests__/fixtures/tarballs/*.tar.gz

# Test files
.test/
test-output/

# Environment variables (secrets, never commit)
.env
.env.local

# Local overrides (developer-specific, never commit)
CLAUDE.local.md

# Agent working memory (local-only)
.claude/agent-memory/

# Igris v6 — symlinks created by `igris register` (machine-specific)
.claude/agents/
.claude/rules/
.claude/skills/

# Machine-local version stamp written by the CLI installer
.igris_version
