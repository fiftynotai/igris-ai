#!/bin/bash
set -e

# Description: Igris pre-commit hook. Runs validators ONLY when their
#   relevant files are staged, so unrelated commits stay fast.
#
# Validators:
#   - validate_brain_stewardship_enums.sh  (DRIFT-1, TD-070, TD-092; renamed in TD-148)
#       Triggers if: core/prompts/brain_stewardship.md OR
#                    brain-mcp-server/src/engine/components/memory/index.ts
#                    is staged. (FR-187: the igris_os.md monolith was deleted;
#                    the validator only ever read brain_stewardship.md.)
#   - validate_skill_frontmatter_yaml.py  (TD-219, #587)
#       Triggers if: any core/skills/*/SKILL.md is staged.
#       Strict YAML parse of SKILL.md frontmatter — catches an unquoted
#       mid-scalar `: ` that strict parsers (Codex) silently skip.
#   - validate_skill_os_harness_leak.py  (TD-248)
#       Triggers if: any core/skills/*/SKILL.md OR core/os/*.md OR
#                    core/prompts/*.md is staged.
#       Scans the skill/OS core for known harness-leak token classes
#       (CLAUDE_CODE_* flags, per-harness config-path targets,
#       define_subagent/invoke_subagent) and hard-fails on a genuine
#       instruction-level leak. Conservative recurrence net (L-400) with an
#       explicit allowlist for the adapter-authoring/by-design files.
#   - validate_skill_required_args.py  (TD-324)
#       Triggers if: any core/skills/**/*.md OR
#                    brain-mcp-server/src/engine/components/*/index.ts OR
#                    MAINTAINING.md is staged.
#       Flags a skill call site that names a brain tool without naming one of
#       its declared-required arguments — which BR-080 turned from a silent
#       NULL bind into a gateway REJECTION. The COMPONENT trigger is the
#       load-bearing half: adding a key to an existing tool's `required` array
#       is what silently invalidates skill prose that already calls it, and no
#       compiler or test sees skill markdown. Ships with an explicit
#       disposition ledger (TD-324 classified all 56 sites: 26 prose, 27
#       already-loud, 3 regressions fixed), so clean-tree output is ZERO and
#       the only thing it ever reports is a NEW site. WARN only.
#   - validate_skill_secret_handling.py  (TD-492)
#       Triggers if: any core/skills/**/*.md OR the validator itself OR
#                    scripts/validate_skill_required_args.py (whose window
#                    rule it imports) is staged.
#       Hard-fails on skill text that names a secret as a tool argument or
#       CLI flag, or names config.json outside a recognised form (a negated
#       read that governs the mention, the CLI reading it itself, or a
#       ledgered descriptive mention): both put the remote brain's API key
#       into the transcript. Fail-closed with an explicit content-keyed
#       ledger, so a clean tree reports no finding (one OK line).
#   - validate_lockfile_in_sync.sh  (TD-134)
#       Triggers if: package.json (root) OR package-lock.json OR
#                    cli/package.json OR brain-mcp-server/package.json
#                    is staged.
#   - validate_harness_drift.sh  (FR-135, TD-021; trigger re-pointed TD-389)
#       Triggers if a PROJECTION INPUT is staged: core/agents/*.md OR the
#                    root harness-manifest.json OR cli-adapters'
#                    surfaces-manifest.json / manifest.schema.json. NOT on
#                    generated harness paths — gitignored, never staged
#                    (OD-4); the guard checks the ON-DISK generated copies.
#   - check_contract_consumers.sh  (FR-186)
#       Triggers if: MAINTAINING.md is staged, OR the staged diff
#                    deletes/renames any path (where a mapped `file` contract
#                    would surface). Surfaces the consumer list (WARN, does not
#                    block); hard-fails on a STALE MAP. Every cause of a
#                    STALE MAP is listed in ONE place, the checker's own
#                    `--help` (TD-346), so this gloss does not repeat them. A
#                    citation on a blank line or a bare closing delimiter
#                    WARNS instead (exit 0).
#   - validate_brief_state_reconciliation.sh  (TD-257)
#       Triggers if: core/skills/hunt/SKILL.md OR
#                    brain-mcp-server/src/tools/briefs.ts OR MAINTAINING.md
#                    is staged.
#       Flags status<->phase<->git contradictions (Done-but-not-COMPLETE,
#       Done-but-no-commit, committed-but-open) against the canonical
#       brief_status.status source. WARN only — surfaces the report, does
#       NOT block the commit (matches check_contract_consumers' posture).
#   - validate_brief_type_vocabulary.sh  (TD-328)
#       Triggers if: brain-mcp-server/src/tools/brief-normalize.ts OR
#                    brain-mcp-server/src/db.ts OR MAINTAINING.md is staged.
#       Reports the brief_status.brief_type distribution and names every
#       non-canonical value. This is the ACCUMULATION observer that keeps
#       read-widen (#228) from becoming permanent silence — the write-
#       boundary echo in briefs.ts catches MINTING, this catches values that
#       arrive via remote sync or an older client. WARN only — surfaces the
#       report, does NOT block the commit.
#   - validate_brief_priority_vocabulary.sh  (TD-338)
#       Triggers if: brain-mcp-server/src/tools/brief-normalize.ts OR
#                    brain-mcp-server/src/tools/sync.ts OR
#                    brain-mcp-server/src/db.ts OR cli/src/lib/brain-db.ts OR
#                    MAINTAINING.md is staged.
#       The priority twin of the brief_type validator. Reports the
#       brief_status.priority distribution and names every non-canonical
#       value; NULL is *unset*, not an offender. priority had NO observer at
#       all before TD-338 (the TD-328 echo covers brief_type only), which is
#       how a lone P4-Trivial sat unnoticed for months. The two mergeRows
#       triggers are here because replication ingress is now a normalization
#       boundary and those files are where it can regress. WARN only —
#       P4-Trivial is a standing WARN by design (folding it would invent a
#       value; adopting it would trigger the FR-247 picker mirror sweep for
#       one row), so it stays reported until a human retypes the brief.
#   - validate_brief_status_vocabulary.sh  (TD-333)
#       Triggers if: brain-mcp-server/src/tools/brief-normalize.ts OR
#                    brain-mcp-server/src/db.ts OR
#                    core/skills/release/SKILL.md OR
#                    scripts/validate_brief_state_reconciliation.sh OR
#                    MAINTAINING.md is staged.
#       The status twin, and the one that matters most: brief_status.status is
#       the CANONICAL BUILD-STATE SOURCE and had neither a normalizer nor an
#       observer until TD-333, which is how 15 distinct values accumulated for
#       six documented states. Reports the distribution and SPLITS the
#       offenders into two classes — DOCUMENTED GAP (Cancelled / Superseded /
#       Deferred, non-canonical by decision, with the follow-up brief named)
#       and STRAY (everything else, which wants a human now) — so a permanent
#       expected WARN cannot train the reader to ignore a real one. The
#       release-gate and reconciler triggers are here because those two files
#       are where a status predicate can regress. WARN only.
#   - validate_brief_ac_completion.sh  (TD-325)
#       Triggers if: core/skills/hunt/SKILL.md OR
#                    core/scripts/brief_ac_check.sh OR
#                    core/git-hooks/commit-msg OR
#                    brain-mcp-server/src/tools/briefs.ts OR MAINTAINING.md
#                    is staged.
#       Reports every TERMINAL brief whose acceptance criteria are still open,
#       or whose deferral lacks a reason or a follow-up brief. This is the L3
#       ACCUMULATION OBSERVER of the AC gate: the hard-fail lives in
#       core/git-hooks/commit-msg (L2) and only fires on a commit carrying a
#       `closes #<ID>` footer, so a brief closed with NO commit — /archive, a
#       direct igris_brief_sync, the dashboard, remote sync — is invisible to it
#       and lands here instead. It is ALSO the driver for TD-075's retroactive
#       sweep (`--list` emits the worklist), which is why it and the gate share
#       one parser: the audit population and the refusal set are then identical
#       by construction. WARN only — surfaces the report, does NOT block. It
#       deliberately never touches the cognition candidate queue (TD-325 AC #7).
#   - validate_hunt_agent_event_sites.sh  (FR-267)
#       Triggers if: core/skills/hunt/SKILL.md OR
#                    brain-mcp-server/src/engine/components/instances/index.ts
#                    is staged.
#       Derivation guard over the hunt skill's igris_agent_event call sites:
#       every window names instance_id / agent / event_type / model_requested
#       (the gateway REQUIRES the fourth since FR-267), no window passes
#       duration_ms or round (the brain computes both), the start sites cover
#       architect/forger/sentinel/warden/document/mender, and at least 13
#       sites exist. The COMPONENT trigger is the load-bearing half: the tool's
#       `required` list lives there, and widening it is what silently breaks
#       skill prose. HARD-fails — clean-tree output is one `OK: <n> sites`.
#   - validate_ceremony_sites.sh  (FR-268)
#       Triggers if: core/skills/boot/SKILL.md OR core/skills/rest/SKILL.md OR
#                    core/skills/register/SKILL.md OR core/skills/hunt/SKILL.md
#                    is staged.
#       Authoring control over the four ceremony skills' `igris ceremony
#       start|stop --name <n>` call sites: exactly one start and one stop per
#       skill, named for that skill's ceremony, the start above the first
#       executable step and the stop below the last (heading-anchored), and
#       never inside an igris_agent_event window. A ceremony's cost is a
#       brain-timed pair written by a VERB; this keeps the skill calling it.
#       HARD-fails — clean-tree output is `OK: 4 skills, 8 sites`.
#   - validate_harness_tier_claims.sh  (TD-367)
#       Triggers if: harness-manifest.json OR README.md OR cli/README.md OR
#                    docs/multi-cli.md OR docs/SETUP_GUIDE.md OR
#                    docs/substitution.md OR MAINTAINING.md OR any core/**/*.md
#                    is staged.
#       Scans that published doc list PLUS every markdown file under core/ (the
#       TD-096-mirrored OS prose read at Boot on every install) for a
#       HAND-WRITTEN harness count ("all five harnesses", "all-four-harness")
#       and reports each one against the count the descriptor actually declares. A harness TIER derives from
#       harnesses.<id>.hooks.supported and the roster derives from the
#       descriptor's keys, so a numeral in prose is an uncoupled copy — five
#       artifacts disagreed on the count before TD-367, two of them with
#       themselves. Both CHANGELOGs are excluded BY DESIGN: a shipped
#       changelog is a historical record, corrected by an appended note, and a
#       scanner that flagged it would push someone to rewrite history. WARN
#       only — surfaces the report, does NOT block the commit.
#   - validate_error_fingerprint_loop.sh  (TD-240)
#       Triggers if: core/agents/mender.md OR core/skills/hunt/SKILL.md is
#                    staged.
#       Ensures mender keeps lookup-before-diagnosis language and /hunt keeps
#       verified post-fix storage ownership via igris_error_lookup.
#   - gitleaks protect --staged  (TD-159)
#       Always runs (gitleaks decides what to scan from the staged set).
#       Deterministic secret-scanner — catches the secret-shaped strings
#       every other gate misses (IPv4 outside RFC-1918/loopback, API-key
#       shapes, SSH private keys, AWS/Stripe/Slack/GitHub tokens, plus the
#       Igris-specific operator-VPS-IP family rule). Config: .gitleaks.toml
#       when the repo carries one (--config), gitleaks' built-in ruleset
#       otherwise — FR-243 dropped the `[ -f .gitleaks.toml ]` condition that
#       used to skip the whole scan, silently, in every consumer repo.
#       HARD-fails the commit on any finding (layer 1 of the 4-layer model).
#       Degrades LOUDLY (a DISARMED box on every commit + the layers line's
#       `secret-scan=DISARMED` token + doctor's `secret-scan-disarmed` row)
#       if gitleaks is not installed; the commit still proceeds (TD-159
#       posture) — CI (.github/workflows/secrets-scan.yml) is the
#       non-bypassable net for this repo.
#       See docs/operations/secret-scanning.md. WHY: TD-157 (the IP leak
#       that survived 5 hunts + every other gate, caught only by manual
#       git grep). Bypass with `--no-verify` only in an emergency.
#
# (TD-110 canonical-hooks lockstep validator was retired in MG-014 M5;
#  the legacy `install_claude_hooks.sh` shell emitter is gone, so the
#  source-of-truth is `core/hooks/canonical-settings.json` consumed
#  directly by the native TS layer in `cli/src/lib/canonical-hooks.ts`.)
#
# FR-243 — consumer behaviour. This file is CANONICAL at core/git-hooks/
# (scripts/git-hooks/pre-commit is a tracked symlink to it) and rides the
# core channel to `~/.igris/core/git-hooks/pre-commit` on every machine that
# runs `igris refresh`; `igris install <path>` symlinks a consumer project's
# `.git/hooks/pre-commit` there, and `igris doctor` reports `git-hooks-missing`
# / `secret-scan-disarmed` when the chain is broken. One script, three layers,
# each stated on EVERY run by the layers line (grammar pinned in
# MAINTAINING.md, "git-level gate projection contract"):
#   phase-guard      active iff sqlite3 + $HOME/.igris/memory/knowledge.db
#                    exist; otherwise `off (<reason>)` — fail-open, but SAID.
#   secret-scan      active iff gitleaks is on PATH; `(repo config)` when the
#                    repo carries .gitleaks.toml, `(gitleaks defaults)` when
#                    not; `DISARMED (gitleaks not installed)` otherwise.
#   repo-validators  the 27 `$REPO_ROOT/scripts/validate_*` sites between the
#                    IGRIS_REPO_INTERNAL markers below run ONLY on the igris-ai
#                    checkout — the one repo carrying ALL of
#                    harness-manifest.json + brain-mcp-server/ +
#                    scripts/git-hooks/. A consumer never has all three, so
#                    the region is inert there and the line says `n/a`.
#   .gitleaks.toml is deliberately NEVER projected to consumers (it embeds an
#   operator-private IP family — see docs/operations/secret-scanning.md).
#
# Bypass: `git commit --no-verify` (use sparingly; CI will catch it)
# Bypass phase guard only: `IGRIS_BYPASS_PHASE_GUARD=1 git commit ...`
#   (one-shot override; never export it. /hunt does not need it: it commits
#   after the brief has left BUILDING/TESTING, carrying IGRIS_INSTANCE_ID so
#   the guard identifies its session — TD-494)
# NB the closing-commit gates' bypasses — `IGRIS_BYPASS_AC_GATE=1` (TD-325),
#   `IGRIS_BYPASS_EVENT_GATE=1` (FR-267) and `IGRIS_BYPASS_REVIEW_MODEL_GATE=1`
#   (FR-277) — belong to core/git-hooks/commit-msg,
#   NOT to this file. Deliberately separate: a closing commit may carry
#   IGRIS_BYPASS_PHASE_GUARD, so a check placed inside the phase guard's block
#   below would be bypassed on exactly the commits those gates must inspect.

# TD-359 — locate the ONE project resolver, `igris_resolve_project` in
# core/hooks/shared/_gate.sh (the shared hooks' registration gate; it only
# DEFINES functions). Done BEFORE the `cd` below, because `$0` may be relative
# to the directory git started the hook in. Order:
#   1. the hook's REAL directory (the `$0` symlink chain followed with
#      readlink, at most 16 hops) + ../hooks/shared/_gate.sh — the repo's
#      core/ on the igris-ai checkout (.git/hooks -> scripts/git-hooks ->
#      core/git-hooks), the runtime mirror for a consumer (.git/hooks/<name> ->
#      $(brainDir())/core/git-hooks/<name>, FR-243);
#   2. $HOME/.igris/core/hooks/shared/_gate.sh;
#   3. neither defines the resolver (a half-deployed core: new hook, old
#      _gate.sh) -> the phase guard keeps basename(toplevel), its tagged last
#      resort. Never an error. MAINTAINING row 151 (the consumer contract).
_IGRIS_LOC_PATH="${BASH_SOURCE[0]:-$0}"
case "$_IGRIS_LOC_PATH" in /*) ;; *) _IGRIS_LOC_PATH="$PWD/$_IGRIS_LOC_PATH" ;; esac
_IGRIS_LOC_HOPS=0
while [ -L "$_IGRIS_LOC_PATH" ] && [ "$_IGRIS_LOC_HOPS" -lt 16 ]; do
  _IGRIS_LOC_LINK="$(readlink "$_IGRIS_LOC_PATH" 2>/dev/null)" || break
  [ -n "$_IGRIS_LOC_LINK" ] || break
  case "$_IGRIS_LOC_LINK" in
    /*) _IGRIS_LOC_PATH="$_IGRIS_LOC_LINK" ;;
    *)  _IGRIS_LOC_PATH="${_IGRIS_LOC_PATH%/*}/$_IGRIS_LOC_LINK" ;;
  esac
  _IGRIS_LOC_HOPS=$((_IGRIS_LOC_HOPS + 1))
done
for _IGRIS_LOC_GATE in "${_IGRIS_LOC_PATH%/*}/../hooks/shared/_gate.sh" "$HOME/.igris/core/hooks/shared/_gate.sh"; do
  if [ -f "$_IGRIS_LOC_GATE" ]; then
    # `|| true`: a sourced file runs with errexit suspended, so a broken copy
    # can never abort the commit; it just leaves the resolver undefined.
    # shellcheck source=/dev/null
    . "$_IGRIS_LOC_GATE" >/dev/null 2>&1 || true
  fi
  if type igris_resolve_project >/dev/null 2>&1; then
    break
  fi
done

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# FR-243 — the active-layers line, printed on EVERY run. A consumer commit
# with nothing to validate used to exit 0 in silence, which is byte-for-byte
# what a disarmed gate looks like. Grammar (a contract — MAINTAINING.md
# "git-level gate projection contract"; read by test/git_hooks_consumer.test.bash):
#   [pre-commit] layers: phase-guard=<v> secret-scan=<v> repo-validators=<v>
# three fixed keys in that order; each value is one token plus at most ONE
# parenthetical reason. bash 3.2: string vars and if/case, no arrays.
#
# The discriminator: the igris-ai checkout is the ONLY repo carrying all of
# harness-manifest.json, brain-mcp-server/ and scripts/git-hooks/. A consumer
# never has all three, so the repo-internal validator region is inert there
# and the line says so — instead of running 27 `$REPO_ROOT/scripts/validate_*`
# sites that do not exist in a consumer (which blocked a consumer commit that
# happened to stage core/skills/x/SKILL.md: python3 "No such file" -> failed=1).
IGRIS_REPO_INTERNAL=0
if [ -f "$REPO_ROOT/harness-manifest.json" ] && [ -d "$REPO_ROOT/brain-mcp-server" ] \
   && [ -d "$REPO_ROOT/scripts/git-hooks" ]; then
  IGRIS_REPO_INTERNAL=1
fi

PHASE_GUARD_STATE="active"
if ! command -v sqlite3 >/dev/null 2>&1; then
  PHASE_GUARD_STATE="off (no sqlite3)"
elif [ ! -f "$HOME/.igris/memory/knowledge.db" ]; then
  PHASE_GUARD_STATE="off (no brain db)"
fi
# A commit that carries the bypass is not gated, so "active" would be a false
# claim on exactly the commits where someone chose to skip the guard.
if [ "${IGRIS_BYPASS_PHASE_GUARD:-0}" = "1" ]; then
  PHASE_GUARD_STATE="bypassed (IGRIS_BYPASS_PHASE_GUARD=1)"
fi

# $GITLEAKS_CONFIG is consumed by the TD-159 tail: non-empty => --config.
SECRET_SCAN_STATE="DISARMED (gitleaks not installed)"
GITLEAKS_CONFIG=""
if command -v gitleaks >/dev/null 2>&1; then
  if [ -f "$REPO_ROOT/.gitleaks.toml" ]; then
    SECRET_SCAN_STATE="active (repo config)"
    GITLEAKS_CONFIG="$REPO_ROOT/.gitleaks.toml"
  else
    SECRET_SCAN_STATE="active (gitleaks defaults)"
  fi
fi

REPO_VALIDATORS_STATE="n/a (not the igris-ai checkout)"
if [ "$IGRIS_REPO_INTERNAL" = "1" ]; then
  REPO_VALIDATORS_STATE="active (igris-ai)"
fi

echo "[pre-commit] layers: phase-guard=$PHASE_GUARD_STATE secret-scan=$SECRET_SCAN_STATE repo-validators=$REPO_VALIDATORS_STATE"

# Phase guard (PI-004 / L-248): refuse a commit while the COMMITTING SESSION's
# brief is in BUILDING or TESTING. The /hunt state machine routes BUILDING ->
# TESTING -> REVIEWING -> COMMITTING; a commit that fires while this session's
# brief is still being built or tested has skipped those phases.
#
# Bypass: IGRIS_BYPASS_PHASE_GUARD=1 git commit ...  (one-shot; never export it)
#
# Phase source: brain DB (brief_status.phase) — the canonical live phase
# tracker (FR-186 / G-01R). TD-494 changed only which BRIEF is looked up.
#
# Project (TD-359): `igris_resolve_project "$REPO_ROOT"` from _gate.sh (the
# locator above), so a linked worktree resolves to its main checkout's project
# (marker, then the git main checkout, then the registry walk on the
# worktree-translated path, then basename(main)). basename(toplevel) is the
# tagged last resort, used only when the resolver is unavailable.
#
# Which brief (TD-494): the brief of the session that is COMMITTING — never the
# newest instance or session file on the machine. Every tier is filtered by
#   project_slug = <resolved slug> AND <this machine, BR-100> AND status='active'
# and the session is identified in this order:
#   S1  IGRIS_INSTANCE_ID, when it is shaped like an id ([A-Za-z0-9-], 8 to 64
#       characters) and names such a row. A well-shaped id that names NO such
#       row leaves the session UNIDENTIFIED: it never falls through to a guess
#       (the TD-411 override posture, MAINTAINING row 129). An unparseable
#       value falls through to S2. Pass it one-shot on the commit
#       (`IGRIS_INSTANCE_ID=<id> git commit ...`, or as a prefix to
#       core/scripts/scoped_commit.sh, which hands its environment to git);
#       never export it.
#   S2  owner-process ancestry: one `ps -Ao pid=,ppid=` snapshot, walked from
#       this hook up at most 16 hops. A row whose owner_pid is an ancestor
#       counts only when `ps -p <pid> -o lstart=`, trimmed, equals its
#       owner_started_at byte for byte (the getProcessStartTime format,
#       cli/src/lib/process-liveness.ts): that defeats pid reuse. The NEAREST
#       ancestor with a verified row decides — one row is the session, several
#       are ambiguous and fall to S3. Skipped on a brain whose instances table
#       has no owner columns.
#   S3  the worktree root: rows whose project_path is the realpath of the
#       toplevel (or its `~/...` form). Exactly ONE of them live — an unexpired
#       lease, or an owner pid and start time that verify as in S2 — is the
#       session; zero or several is unidentified.
#   UNIDENTIFIED (operator decision D1): fail OPEN — the commit is not gated —
#       with ONE notice line,
#         [pre-commit] phase-guard: committing session not identified (<reason>) — commit not gated
#       printed only when the project has at least one active instance on this
#       machine, so a plain-git consumer stays silent.
# No tier selects by recency (TD-494 AC1): the old "newest active instance",
# "newest per-instance session file" and legacy CURRENT_SESSION.md tiers are
# deleted, and a new tier must never add one back.
#
# No brief (TD-494 AC4): the identified row's current_brief, trimmed, means
# "no brief" when it is NULL, '' or `none` in any letter case — nothing to
# gate, a silent allow. '' is the value the writers use (/hunt COMPLETE, /rest).
#
# Failure mode: no brain DB or no sqlite3 -> the guard is off (the layers line
# says so). Any query error reads as "no row" -> fail OPEN. Phases other than
# BUILDING/TESTING never refuse.

if [ "${IGRIS_BYPASS_PHASE_GUARD:-0}" != "1" ]; then
  HOSTNAME_LOCAL="$(hostname)"
  BRAIN_DB="$HOME/.igris/memory/knowledge.db"
  ACTIVE_BRIEF=""

  # _pg_owner_verified <pid> <owner_started_at> — 0 iff <pid> is running and
  # its `ps -o lstart=` start time, trimmed (JS .trim() parity), equals the
  # stored value byte for byte. The compare sits between the TD-494 S2 markers:
  # test/phase_guard.test.bash (s2m) deletes that block and proves a pid-only
  # match would identify a recycled pid.
  _pg_owner_verified() {
    local ok=1 now=""
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    # TD-494 S2 lstart: begin
    ok=0
    now="$(ps -p "$1" -o lstart= 2>/dev/null)" || now=""
    now="${now#"${now%%[![:space:]]*}"}"
    now="${now%"${now##*[![:space:]]}"}"
    if [ -n "$now" ] && [ "$now" = "$2" ]; then ok=1; fi
    # TD-494 S2 lstart: end
    [ "$ok" = "1" ]
  }

  # TD-453 (2026-09-07): every value interpolated below is single-quote-escaped
  # with an UNQUOTED assignment on purpose — under /bin/bash 3.2 (this hook's
  # shebang) the double-quoted form keeps the backslashes literal (`it\'\'s`),
  # sqlite3 rejects the literal, the error is discarded and the guard fails
  # OPEN. test/phase_guard.test.bash: h1-h3 + h6 prove the real hook resolves a
  # quoted alias / hostname / project name / worktree root (and admits no
  # injected row); h4, h4b, h4c, h4d prove the SAME inputs read as "no active
  # brief" (or admit a foreign row) on a no-escape MUTANT of the alias /
  # hostname / machine-id sites; h5 is the mutant's surviving control. The
  # other sites have no mutant case. MAINTAINING row 153.
  #
  # BR-100: "this machine" is the machine IDENTITY, not the hostname. A row
  # carrying a `machine_id` must match config.json `machine.id`; a row whose
  # `machine_id` is NULL (legacy, or inbound replicated) is mine iff its hostname
  # is the live hostname or one of `machine.aliases`. A brain older than
  # instances v5 has no column → the hostname-IN-aliases form. No python3 or no
  # config.json → the live hostname alone, i.e. the pre-BR-100 query. bash 3.2.
  # The predicate is built ONCE and filters every tier (S1, S2, S3, the notice).
  if [ -f "$BRAIN_DB" ] && command -v sqlite3 >/dev/null 2>&1; then
    # TD-359: the project this commit belongs to.
    PROJECT=""
    PROJECT_SOURCE=""
    if type igris_resolve_project >/dev/null 2>&1; then
      igris_resolve_project "$REPO_ROOT"
      PROJECT="$_IGRIS_RES_SLUG"
      PROJECT_SOURCE="$_IGRIS_RES_SOURCE"
    fi
    if [ -z "$PROJECT" ]; then
      PROJECT="$(basename "$REPO_ROOT")"  # TD-359 last-resort: the resolver is unavailable
      PROJECT_SOURCE="basename"
    fi
    PROJECT_SQL=${PROJECT//\'/\'\'}
    HOSTNAME_SQL=${HOSTNAME_LOCAL//\'/\'\'}
    MACHINE_ID=""
    ALIASES_SQL="'$HOSTNAME_SQL'"
    # BR-100 identity: begin
    CONFIG_JSON="$HOME/.igris/config.json"
    if [ -f "$CONFIG_JSON" ] && command -v python3 >/dev/null 2>&1; then
      # One line, TAB-separated: id, then every string alias. Empty on any
      # parse failure, which falls back to the live hostname alone.
      IDENTITY_LINE="$(python3 -c '
import json, sys
try:
    m = json.load(open(sys.argv[1])).get("machine") or {}
    mid = m.get("id") if isinstance(m.get("id"), str) else ""
    al = [a for a in (m.get("aliases") or []) if isinstance(a, str) and a]
    print("\t".join([mid] + al))
except Exception:
    pass
' "$CONFIG_JSON" 2>/dev/null)"
      if [ -n "$IDENTITY_LINE" ]; then
        TAB="$(printf '\t')"
        MACHINE_ID="${IDENTITY_LINE%%"$TAB"*}"
        ALIAS_REST="${IDENTITY_LINE#*"$TAB"}"
        [ "$ALIAS_REST" = "$IDENTITY_LINE" ] && ALIAS_REST=""
        OLD_IFS="$IFS"
        IFS="$TAB"
        for alias in $ALIAS_REST; do
          [ "$alias" = "$HOSTNAME_LOCAL" ] && continue
          alias_sql=${alias//\'/\'\'}
          ALIASES_SQL="$ALIASES_SQL, '$alias_sql'"
        done
        IFS="$OLD_IFS"
      fi
    fi
    # BR-100 identity: end
    INSTANCES_COLS="$(sqlite3 "$BRAIN_DB" "PRAGMA table_info(instances);" 2>/dev/null)" || INSTANCES_COLS=""
    case "$INSTANCES_COLS" in
      *'|machine_id|'*)
        MACHINE_ID_SQL=${MACHINE_ID//\'/\'\'}
        MACHINE_WHERE="(machine_id = '$MACHINE_ID_SQL' OR (machine_id IS NULL AND machine_hostname IN ($ALIASES_SQL)))" ;;
      *)
        MACHINE_WHERE="machine_hostname IN ($ALIASES_SQL)" ;;
    esac
    SESSION_WHERE="project_slug = '$PROJECT_SQL' AND $MACHINE_WHERE AND status = 'active'"
    # Column separator for multi-column reads: the ASCII unit separator, NOT a
    # tab — a tab is IFS whitespace, and `read` would collapse an empty field.
    S_SEP="$(printf '\037')"
    S_ID=""
    S_HOW=""
    S_REASON=""
    S1_DECIDED=0
    S2_ON=0
    case "$INSTANCES_COLS" in
      *'|owner_pid|'*)
        case "$INSTANCES_COLS" in *'|owner_started_at|'*) S2_ON=1 ;; esac ;;
    esac

    # S1 — IGRIS_INSTANCE_ID. A parseable id decides, found or not.
    if [ -n "${IGRIS_INSTANCE_ID:-}" ]; then
      case "$IGRIS_INSTANCE_ID" in
        *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-]*) ;;
        *)
          if [ "${#IGRIS_INSTANCE_ID}" -ge 8 ] && [ "${#IGRIS_INSTANCE_ID}" -le 64 ]; then
            S1_DECIDED=1
            S1_ID_SQL=${IGRIS_INSTANCE_ID//\'/\'\'}
            S_ID="$(sqlite3 "$BRAIN_DB" "SELECT id FROM instances WHERE id = '$S1_ID_SQL' AND $SESSION_WHERE LIMIT 1;" 2>/dev/null)" || S_ID=""
            if [ -n "$S_ID" ]; then
              S_HOW="IGRIS_INSTANCE_ID"
            else
              S_REASON="IGRIS_INSTANCE_ID=$IGRIS_INSTANCE_ID names no active instance of $PROJECT on this machine"
            fi
          fi
          ;;
      esac
    fi

    # S2 — owner-process ancestry (nearest verified ancestor decides).
    if [ -z "$S_ID" ] && [ "$S1_DECIDED" = "0" ] && [ "$S2_ON" = "1" ]; then
      S2_CHAIN="$(ps -Ao pid=,ppid= 2>/dev/null | awk -v start="$$" '
        { parent[$1] = $2 }
        END {
          cur = start; n = 0
          while (cur ~ /^[0-9]+$/ && cur + 0 > 1 && n < 16) { printf "%s ", cur; cur = parent[cur]; n++ }
        }' 2>/dev/null)" || S2_CHAIN=""
      S2_PIDS=""
      for S2_P in $S2_CHAIN; do
        case "$S2_P" in ''|*[!0-9]*) continue ;; esac
        S2_PIDS="$S2_PIDS${S2_PIDS:+,}$S2_P"
      done
      S2_ROWS=""
      if [ -n "$S2_PIDS" ]; then
        S2_ROWS="$(sqlite3 -separator "$S_SEP" "$BRAIN_DB" "SELECT owner_pid, id, COALESCE(owner_started_at, '') FROM instances WHERE $SESSION_WHERE AND owner_pid IN ($S2_PIDS);" 2>/dev/null)" || S2_ROWS=""
      fi
      if [ -n "$S2_ROWS" ]; then
        for S2_P in $S2_CHAIN; do
          S2_N=0
          S2_HIT=""
          while IFS="$S_SEP" read -r S2_RPID S2_RID S2_RSTART; do
            [ "$S2_RPID" = "$S2_P" ] || continue
            if _pg_owner_verified "$S2_RPID" "$S2_RSTART"; then
              S2_N=$((S2_N + 1))
              S2_HIT="$S2_RID"
            fi
          done <<PG_S2_ROWS
$S2_ROWS
PG_S2_ROWS
          if [ "$S2_N" -gt 0 ]; then
            if [ "$S2_N" -eq 1 ]; then
              S_ID="$S2_HIT"
              S_HOW="owner process $S2_P"
            fi
            break
          fi
        done
      fi
    fi

    # S3 — the one live instance at this worktree root.
    if [ -z "$S_ID" ] && [ "$S1_DECIDED" = "0" ]; then
      S3_ON=0
      case "$INSTANCES_COLS" in
        *'|project_path|'*)
          case "$INSTANCES_COLS" in *'|lease_expires_at|'*) S3_ON=1 ;; esac ;;
      esac
      if [ "$S3_ON" = "1" ]; then
        S3_ROOT="$(pwd -P)"
        S3_ROOT_SQL=${S3_ROOT//\'/\'\'}
        S3_PATHS="'$S3_ROOT_SQL'"
        S3_HOME_P=""
        if [ -n "${HOME:-}" ]; then
          S3_HOME_P="$(CDPATH='' cd -- "$HOME" 2>/dev/null && pwd -P)" || S3_HOME_P=""
        fi
        for S3_H in "${HOME:-}" "$S3_HOME_P"; do
          [ -n "$S3_H" ] || continue
          case "$S3_ROOT" in
            "$S3_H"/*)
              S3_TILDE="~${S3_ROOT#"$S3_H"}"
              S3_TILDE_SQL=${S3_TILDE//\'/\'\'}
              S3_PATHS="$S3_PATHS, '$S3_TILDE_SQL'"
              ;;
          esac
        done
        if [ "$S2_ON" = "1" ]; then
          S3_OWNER_COLS="COALESCE(owner_pid, ''), COALESCE(owner_started_at, '')"
        else
          S3_OWNER_COLS="'', ''"
        fi
        S3_ROWS="$(sqlite3 -separator "$S_SEP" "$BRAIN_DB" "SELECT CASE WHEN datetime(lease_expires_at) > datetime('now') THEN 1 ELSE 0 END, id, $S3_OWNER_COLS FROM instances WHERE $SESSION_WHERE AND project_path IN ($S3_PATHS);" 2>/dev/null)" || S3_ROWS=""
        S3_LIVE=0
        S3_HIT=""
        while IFS="$S_SEP" read -r S3_LEASE S3_RID S3_OPID S3_OSTART; do
          [ -n "$S3_RID" ] || continue
          S3_IS_LIVE=0
          if [ "$S3_LEASE" = "1" ]; then
            S3_IS_LIVE=1
          elif [ -n "$S3_OPID" ] && _pg_owner_verified "$S3_OPID" "$S3_OSTART"; then
            S3_IS_LIVE=1
          fi
          if [ "$S3_IS_LIVE" = "1" ]; then
            S3_LIVE=$((S3_LIVE + 1))
            S3_HIT="$S3_RID"
          fi
        done <<PG_S3_ROWS
$S3_ROWS
PG_S3_ROWS
        if [ "$S3_LIVE" -eq 1 ]; then
          S_ID="$S3_HIT"
          S_HOW="the one live instance at $S3_ROOT"
        else
          S_REASON="no owner-process match; $S3_LIVE live instances at $S3_ROOT"
        fi
      else
        S_REASON="instances table predates project_path/lease columns"
      fi
    fi

    if [ -n "$S_ID" ]; then
      # The identified session's brief, normalised (TD-494 AC4).
      S_ID_SQL=${S_ID//\'/\'\'}
      ACTIVE_BRIEF="$(sqlite3 "$BRAIN_DB" "SELECT COALESCE(current_brief, '') FROM instances WHERE id = '$S_ID_SQL' LIMIT 1;" 2>/dev/null)" || ACTIVE_BRIEF=""
      ACTIVE_BRIEF="${ACTIVE_BRIEF#"${ACTIVE_BRIEF%%[![:space:]]*}"}"
      ACTIVE_BRIEF="${ACTIVE_BRIEF%"${ACTIVE_BRIEF##*[![:space:]]}"}"
      case "$ACTIVE_BRIEF" in
        [Nn][Oo][Nn][Ee]) ACTIVE_BRIEF="" ;;
      esac
    else
      # D1: fail open, and SAY so — but only to a project that has sessions.
      S_COUNT="$(sqlite3 "$BRAIN_DB" "SELECT COUNT(*) FROM instances WHERE $SESSION_WHERE;" 2>/dev/null)" || S_COUNT=""
      case "$S_COUNT" in ''|*[!0-9]*) S_COUNT=0 ;; esac
      if [ "$S_COUNT" -gt 0 ]; then
        echo "[pre-commit] phase-guard: committing session not identified (${S_REASON:-no owner-process match}) — commit not gated"
      fi
    fi

    if [ -n "$ACTIVE_BRIEF" ]; then
      # Live phase comes from brain DB (canonical source per /hunt sync flow).
      # The igris_brief_sync MCP tool writes brief_status.phase on every
      # phase transition; brief cache files are NOT updated. The guard's
      # enforcement logic (refuse on BUILDING|TESTING) is unchanged — only the
      # brief-discovery source above changed (FR-186 / G-01R, then TD-494).
      #
      # TD-340 — the status filter FOLDS NOTATION instead of matching one
      # literal. It used to read `status='In Progress'`, which cannot match the
      # 'InProgress' spelling that exists in the live brain; the SELECT returned
      # empty and this guard FAILED OPEN (silently allowed a mid-BUILDING
      # commit). The fold `replace(replace(replace(lower(status),' ',''),
      # '-',''),'_','')` collapses case + space + hyphen + underscore, so every
      # notation of the same word ('In Progress' / 'InProgress' / 'in_progress'
      # / 'IN-PROGRESS') gates identically. Keep byte-aligned with the identical
      # expression in core/hooks/shared/pre_tool_use.sh.
      #
      # It folds NOTATION ONLY, never VOCABULARY: a different WORD ('Completed',
      # 'Done', 'Active', 'WIP') is deliberately NOT matched. This expression
      # catches a new SPELLING; catching a new WORD belongs to the canonical
      # status vocabulary, shipped by TD-333 as normalizeStatus /
      # CANONICAL_STATUSES in brain-mcp-server/src/tools/brief-normalize.ts.
      # This file's own validate_brief_status_vocabulary.sh block (see the
      # header inventory above) is the bash-side observer of that vocabulary.
      BRIEF_SQL=${ACTIVE_BRIEF//\'/\'\'}
      ACTIVE_PHASE="$(sqlite3 "$BRAIN_DB" \
        "SELECT phase FROM brief_status WHERE project='$PROJECT_SQL' AND brief_id='$BRIEF_SQL' AND replace(replace(replace(lower(status),' ',''),'-',''),'_','')='inprogress' LIMIT 1;" \
        2>/dev/null)" || ACTIVE_PHASE=""

      case "$ACTIVE_PHASE" in
        BUILDING|TESTING)
          # TD-494 AC7: mode-neutral — it names what it decided on (the
          # session and how it was identified, the project, the brief, the
          # phase) and no workflow role.
          echo ""
          echo "[pre-commit] PI-004 phase guard: refusing commit"
          echo "  session: ${S_ID:0:8} (identified by $S_HOW)"
          echo "  project: $PROJECT ($PROJECT_SOURCE)"
          echo "  brief: $ACTIVE_BRIEF"
          echo "  phase: $ACTIVE_PHASE"
          echo "  commits wait until this session's brief leaves BUILDING/TESTING"
          echo ""
          echo "  to commit anyway (one-shot; never export it):"
          echo "    IGRIS_BYPASS_PHASE_GUARD=1 git commit ..."
          echo ""
          echo "  this guard exists per PI-004 / L-248. see brief for context."
          exit 1
          ;;
      esac
    fi
  fi
fi

