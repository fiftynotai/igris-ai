# TD-159: gitleaks secret scan (layer 1 of the 4-layer model). Always runs —
# gitleaks scans the staged set itself and decides what to inspect, so there is
# no file-trigger gate (a secret can land in any file type). HARD-fails on any
# finding.
#
# FR-243: the scan no longer waits for a .gitleaks.toml. Until FR-243 the whole
# block sat behind `[ -f "$REPO_ROOT/.gitleaks.toml" ]`, so a consumer repo —
# which never has that file, because it is deliberately NOT projected (it
# embeds an operator-private IP family) — skipped the scan with NO output:
# measured 2026-07-29 in moca-ai-agent, two live API keys staged, `exit 0`,
# silent. Now: the repo's .gitleaks.toml is passed as --config when present
# (igris-ai — its `[extend] useDefault = true` keeps the built-ins, so verdicts
# here are unchanged); when absent, gitleaks runs its built-in ruleset, which
# catches both of the moca keys. $GITLEAKS_CONFIG was resolved with the layers
# line above. bash 3.2: no arrays — the two invocations differ only by the
# --config pair. `protect --staged` scans only the staged diff (<500ms on a
# typical 10-file diff); --redact keeps the secret out of the hook log. set -e
# is bypassed via `|| rc=$?` so the finding is aggregated into $failed and
# reported together with any other validator failures.
if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] Scanning staged changes for secrets (gitleaks)..."
  gitleaks_report="$(mktemp)"
  gitleaks_rc=0
  if [ -n "$GITLEAKS_CONFIG" ]; then
    gitleaks protect --staged \
      --config "$GITLEAKS_CONFIG" \
      --redact \
      --report-format json \
      --report-path "$gitleaks_report" \
      --no-banner >/dev/null 2>&1 || gitleaks_rc=$?
  else
    gitleaks protect --staged \
      --redact \
      --report-format json \
      --report-path "$gitleaks_report" \
      --no-banner >/dev/null 2>&1 || gitleaks_rc=$?
  fi
  if [ "$gitleaks_rc" -ne 0 ]; then
    echo ""
    echo "[pre-commit] gitleaks: SECRET-SHAPED CONTENT DETECTED — refusing commit"
    echo ""
    # Summarise each finding as file:line + rule (secret value redacted).
    if command -v python3 >/dev/null 2>&1 && [ -s "$gitleaks_report" ]; then
      python3 - "$gitleaks_report" <<'PYEOF'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        findings = json.load(fh)
except Exception:
    findings = []
for f in findings:
    loc = f"{f.get('File','?')}:{f.get('StartLine','?')}"
    print(f"  - {loc}  rule={f.get('RuleID','?')}  (secret redacted)")
PYEOF
    else
      echo "  (install python3 to see per-finding file:line; report at $gitleaks_report)"
    fi
    echo ""
    echo "  If this is a REAL secret:"
    echo "    1. Remove it from the staged content (use a placeholder /"
    echo "       \${ENV_VAR} indirection — see CONTRIBUTING.md Documentation"
    echo "       Invariant #9)."
    echo "    2. If it was a live credential, rotate it."
    echo "    3. See docs/operations/secret-scanning.md for the full"
    echo "       remediation decision-tree."
    echo ""
    echo "  If this is a FALSE POSITIVE (test fixture, example URL, etc.):"
    echo "    Add an inline '# gitleaks:allow' marker on the same line with a"
    echo "    one-line rationale, then re-stage. (Or path-allowlist it in"
    echo "    .gitleaks.toml if it is a whole fixture file.)"
    echo ""
    failed=1
  fi
  rm -f "$gitleaks_report"
else
  # LOUD, not blocking (TD-159 posture): a hard block here would be bypassed
  # with --no-verify and teach the wrong habit. The persistent surface is
  # doctor's `secret-scan-disarmed` row; this box is the per-commit one.
  echo ""
  echo "[pre-commit] ============================================================"
  echo "[pre-commit]  SECRET SCAN DISARMED — gitleaks is not installed; this commit"
  echo "[pre-commit]  was NOT scanned for credentials (TD-159 layer 1 is off)."
  echo "[pre-commit]  Install: brew install gitleaks  (github.com/gitleaks/gitleaks/releases)"
  echo "[pre-commit]  \`igris doctor\` reports secret-scan-disarmed until it is on PATH."
  echo "[pre-commit] ============================================================"
  echo ""
fi

if [ "$failed" = "1" ]; then
  echo ""
  echo "Pre-commit checks failed. Fix the drift, then re-stage and re-commit."
  echo "To bypass (not recommended): git commit --no-verify"
  exit 1
fi

