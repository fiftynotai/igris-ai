{
  "name": "igris-brain-mcp-server",
  "version": "7.2.0",
  "description": "Igris AI Centralized Brain MCP Server — persistent memory, project management, cross-project intelligence",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "igris-brain-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist.tmp && tsc --outDir dist.tmp && rm -rf dist && mv dist.tmp dist",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "eval:memory": "tsx eval/memory/src/run.ts",
    "backfill-edges": "tsx scripts/backfill_brief_edges.ts",
    "normalize-brief-types": "tsx scripts/normalize_brief_types.ts",
    "gen:egress-manifest": "tsx scripts/gen-egress-manifest.ts",
    "gen:egress-manifest:check": "tsx scripts/gen-egress-manifest.ts --check",
    "gen:brief-normalize-mirror": "tsx scripts/gen-brief-normalize-mirror.ts",
    "gen:brief-normalize-mirror:check": "tsx scripts/gen-brief-normalize-mirror.ts --check"
  },
  "author": "fifty.dev",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.0",
    "sqlite-vec": "^0.1.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0 <27.0.0"
  }
}
